---
const title = "Start Here | djerhy.tech";
const description = "Five checks that tell you whether your organization has control or just visibility. Free or paid access to Address The Mess.";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Fraunces:ital,wght@0,700;0,900;1,700&display=swap" rel="stylesheet">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --bg: #0D1117;
      --bg2: #111820;
      --text: #e6edf3;
      --muted: #b1bac4;
      --muted2: #7d8896;
      --border: rgba(230,237,243,0.10);
      --border2: rgba(230,237,243,0.06);
      --panel: rgba(230,237,243,0.03);
      --panel2: rgba(230,237,243,0.055);
      --blue: #2F81F7;
      --blue-hover: #1E6AD8;
      --blue-dim: rgba(47,129,247,0.10);
      --blue-border: rgba(47,129,247,0.25);
      --accent: #7fb0ff;
      --red-dim: rgba(239,68,68,0.10);
      --red-border: rgba(239,68,68,0.25);
      --red: #ef4444;
      --green-dim: rgba(34,197,94,0.10);
      --green-border: rgba(34,197,94,0.25);
      --green: #22c55e;
      --amber-dim: rgba(251,191,36,0.10);
      --amber-border: rgba(251,191,36,0.25);
      --amber: #fbbf24;
    }
    html { scroll-behavior: smooth; }
    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }
    .container { max-width: 740px; margin: 0 auto; padding: 0 24px; }

    nav {
      padding: 22px 0;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .logo { font-size: 15px; font-weight: 600; color: var(--text); text-decoration: none; letter-spacing: 0.2px; }
    .nav-links { display: flex; gap: 28px; }
    .nav-links a { font-size: 14px; color: var(--muted); text-decoration: none; transition: color 0.15s; }
    .nav-links a:hover { color: var(--text); }
    .nav-links a.active { color: var(--text); }

    .page-header { padding: 64px 0 48px; }
    .page-eyebrow { font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--blue); margin-bottom: 14px; }
    .page-header h1 {
      font-family: 'Fraunces', serif;
      font-size: clamp(22px, 3vw, 30px);
      font-weight: 700;
      line-height: 1.2;
      letter-spacing: -0.01em;
      margin-bottom: 14px;
      color: var(--muted);
    }
    .page-intro { font-size: 15px; line-height: 1.7; color: var(--muted2); max-width: 560px; }

    .section-label { font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); margin-bottom: 20px; }
    .section-label-primary {
      font-size: 15px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase;
      color: var(--text); margin-bottom: 8px; display: flex; align-items: center; gap: 10px;
    }
    .section-label-primary::after { content: ''; flex: 1; height: 1px; background: var(--border); }

    .checks-section { padding: 48px 0 0; }
    .checks-intro { font-size: 14px; color: var(--muted2); margin-bottom: 24px; line-height: 1.6; }
    .check-card {
      background: var(--panel); border: 1px solid var(--border);
      border-radius: 12px; padding: 24px; margin-bottom: 12px; transition: border-color 0.2s;
    }
    .check-card.answered { border-color: rgba(230,237,243,0.15); }
    .check-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; margin-bottom: 14px; }
    .check-number { font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted2); margin-bottom: 6px; }
    .check-title { font-size: 16px; font-weight: 600; color: var(--text); line-height: 1.3; }
    .check-status {
      width: 24px; height: 24px; border-radius: 50%; border: 1.5px solid var(--border);
      flex-shrink: 0; display: flex; align-items: center; justify-content: center;
      transition: all 0.2s; margin-top: 2px;
    }
    .check-status.done { background: var(--green); border-color: var(--green); }
    .check-body { font-size: 14px; line-height: 1.75; color: var(--muted); margin-bottom: 18px; }
    .check-body em { color: var(--text); font-style: italic; }
    .answer-row { display: flex; gap: 8px; flex-wrap: wrap; }
    .answer-btn {
      padding: 8px 16px; border-radius: 8px; font-size: 13px; font-weight: 600;
      font-family: inherit; cursor: pointer; border: 1px solid var(--border);
      background: var(--panel); color: var(--muted); transition: all 0.15s;
    }
    .answer-btn:hover { background: var(--panel2); border-color: rgba(230,237,243,0.18); color: var(--text); }
    .answer-btn.selected-clear { background: var(--green-dim); border-color: var(--green-border); color: var(--green); }
    .answer-btn.selected-gap { background: var(--red-dim); border-color: var(--red-border); color: var(--red); }
    .answer-btn.selected-unsure { background: var(--amber-dim); border-color: var(--amber-border); color: var(--amber); }
    .check-result { display: none; margin-top: 14px; padding: 12px 16px; border-radius: 8px; font-size: 13px; line-height: 1.6; }
    .check-result.show { display: block; }
    .check-result.clear { background: var(--green-dim); border: 1px solid var(--green-border); color: var(--green); }
    .check-result.gap { background: var(--red-dim); border: 1px solid var(--red-border); color: #fca5a5; }
    .check-result.unsure { background: var(--amber-dim); border: 1px solid var(--amber-border); color: var(--amber); }

    .results-panel {
      display: none; margin: 32px 0 0; padding: 28px 32px;
      background: var(--panel); border: 1px solid var(--border);
      border-radius: 14px; animation: fadeUp 0.35s ease both;
    }
    .results-panel.show { display: block; }
    .results-title { font-family: 'Fraunces', serif; font-size: 22px; font-weight: 700; margin-bottom: 10px; line-height: 1.2; }
    .results-score { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 16px; }
    .score-pill { padding: 6px 14px; border-radius: 999px; font-size: 13px; font-weight: 600; }
    .score-pill.clear { background: var(--green-dim); border: 1px solid var(--green-border); color: var(--green); }
    .score-pill.gap { background: var(--red-dim); border: 1px solid var(--red-border); color: #fca5a5; }
    .score-pill.unsure { background: var(--amber-dim); border: 1px solid var(--amber-border); color: var(--amber); }
    .results-summary { font-size: 15px; line-height: 1.7; color: var(--muted); margin-bottom: 28px; }

    .offer-divider { border-top: 1px solid var(--border); padding-top: 24px; }
    .offer-label { font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); margin-bottom: 16px; }
    .offer-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .offer-card {
      border-radius: 12px; padding: 22px; border: 1px solid var(--border);
      background: var(--panel); display: flex; flex-direction: column; gap: 10px;
    }
    .offer-card.contribute { border-color: var(--green-border); background: var(--green-dim); }
    .offer-card.buy { border-color: var(--blue-border); background: var(--blue-dim); }
    .offer-card-label { font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
    .offer-card.contribute .offer-card-label { color: var(--green); }
    .offer-card.buy .offer-card-label { color: var(--accent); }
    .offer-card-title { font-family: 'Fraunces', serif; font-size: 17px; font-weight: 700; line-height: 1.2; color: var(--text); }
    .offer-card-desc { font-size: 13px; line-height: 1.65; color: var(--muted); flex: 1; }

    /* Contribute form */
    .contribute-form { display: flex; flex-direction: column; gap: 8px; margin-top: 4px; }
    .contribute-input {
      width: 100%; padding: 9px 13px;
      background: rgba(0,0,0,0.25); border: 1px solid var(--green-border);
      border-radius: 7px; color: var(--text); font-family: inherit;
      font-size: 13px; outline: none; transition: border-color 0.15s;
    }
    .contribute-input::placeholder { color: var(--muted2); }
    .contribute-input:focus { border-color: var(--green); }
    .contribute-submit {
      width: 100%; padding: 10px; background: var(--green); color: #0D1117;
      border: none; border-radius: 7px; font-family: inherit; font-size: 13px;
      font-weight: 700; cursor: pointer; transition: opacity 0.15s;
    }
    .contribute-submit:hover { opacity: 0.88; }

    /* Confirmation shown after submit */
    .contribute-confirm {
      display: none;
      background: rgba(0,0,0,0.2);
      border: 1px solid var(--green-border);
      border-radius: 8px;
      padding: 16px;
    }
    .contribute-confirm-title {
      font-size: 13px; font-weight: 700; color: var(--green); margin-bottom: 10px;
    }
    .contribute-confirm-body {
      font-size: 13px; color: var(--muted); line-height: 1.65;
    }
    .download-link {
      display: inline-flex; align-items: center; gap: 6px;
      margin-top: 12px; padding: 9px 16px;
      background: var(--green); color: #0D1117;
      border-radius: 7px; font-size: 13px; font-weight: 700;
      text-decoration: none; transition: opacity 0.15s;
    }
    .download-link:hover { opacity: 0.88; }
    .survey-link {
      display: block; margin-top: 10px;
      font-size: 12px; color: var(--muted2);
      text-decoration: underline; text-underline-offset: 2px;
      transition: color 0.15s;
    }
    .survey-link:hover { color: var(--muted); }
    .offer-note { font-size: 11px; color: var(--muted2); line-height: 1.5; }

    /* Buy CTA */
    .btn-buy {
      display: block; width: 100%; text-align: center;
      padding: 10px; background: var(--blue); color: #fff;
      border: none; border-radius: 7px; font-family: inherit;
      font-size: 13px; font-weight: 700; text-decoration: none;
      transition: background 0.15s; margin-top: 4px;
    }
    .btn-buy:hover { background: var(--blue-hover); }

    .section-divider { height: 1px; background: var(--border); margin: 56px 0; }
    .resources-section { padding-bottom: 20px; }
    .resources-intro { font-size: 14px; color: var(--muted2); margin-bottom: 20px; line-height: 1.65; }
    .resource-card {
      display: flex; align-items: center; justify-content: space-between; gap: 16px;
      background: var(--panel); border: 1px solid var(--border2); border-radius: 10px;
      padding: 18px 20px; text-decoration: none; margin-bottom: 10px;
      transition: border-color 0.15s, background 0.15s;
    }
    .resource-card:hover { background: var(--panel2); border-color: var(--border); }
    .resource-card-info { flex: 1; }
    .resource-card-title { font-size: 14px; font-weight: 600; color: var(--text); margin-bottom: 3px; }
    .resource-card-meta { font-size: 13px; color: var(--muted2); line-height: 1.5; }
    .resource-badge {
      font-size: 11px; font-weight: 700; letter-spacing: 0.06em; color: var(--muted2);
      background: rgba(230,237,243,0.05); border: 1px solid var(--border2);
      padding: 4px 10px; border-radius: 999px; white-space: nowrap; flex-shrink: 0;
    }

    footer {
      border-top: 1px solid var(--border); padding: 36px 0 40px;
      display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;
    }
    .footer-id { font-size: 13px; color: var(--muted); font-weight: 500; }
    .footer-links { display: flex; gap: 20px; }
    .footer-links a { font-size: 13px; color: var(--muted2); text-decoration: none; transition: color 0.15s; }
    .footer-links a:hover { color: var(--text); }
    .footer-copy { width: 100%; font-size: 12px; color: var(--muted2); margin-top: 4px; }

    @keyframes fadeUp { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

    @media (max-width: 600px) {
      .page-header { padding: 48px 0 36px; }
      .results-panel { padding: 22px 20px; }
      .offer-grid { grid-template-columns: 1fr; }
      footer { flex-direction: column; align-items: flex-start; }
      .answer-row { flex-direction: column; }
      .answer-btn { text-align: center; }
    }
  </style>
</head>
<body>

<div class="container">
  <nav>
    <a href="/" class="logo">djerhy.tech</a>
    <div class="nav-links">
      <a href="/start-here" class="active">Start Here</a>
      <a href="/field-notes">Field Notes</a>
    </div>
  </nav>
</div>

<div class="container">
  <header class="page-header">
    <div class="page-eyebrow">Visibility vs. Control</div>
    <h1>Find out if you have control<br>or just visibility.</h1>
    <p class="page-intro">
      Five checks. Each one takes under 10 minutes. Together they tell you whether your organization can identify responsibility, make a decision, and act on a system without delay.
    </p>
  </header>

  <section class="checks-section">
    <div class="section-label-primary">Run the checks</div>
    <p class="checks-intro">Answer honestly. No one sees your results but you.</p>

    <div class="check-card" id="check-1">
      <div class="check-header">
        <div><div class="check-number">Check 01</div><div class="check-title">Departed Access</div></div>
        <div class="check-status" id="status-1"></div>
      </div>
      <div class="check-body">Pull a list of people who left in the last 12 months. Pick one. Check whether their access still works.</div>
      <div class="answer-row">
        <button class="answer-btn" data-check="1" data-type="gap">Access still works</button>
        <button class="answer-btn" data-check="1" data-type="unsure">Cannot check</button>
        <button class="answer-btn" data-check="1" data-type="clear">Access confirmed removed</button>
      </div>
      <div class="check-result" id="result-1"></div>
    </div>

    <div class="check-card" id="check-2">
      <div class="check-header">
        <div><div class="check-number">Check 02</div><div class="check-title">Retired Systems</div></div>
        <div class="check-status" id="status-2"></div>
      </div>
      <div class="check-body">Name one system you retired in the last 6 months. Verify three things: network route, login access, billing line.</div>
      <div class="answer-row">
        <button class="answer-btn" data-check="2" data-type="gap">One or more still active</button>
        <button class="answer-btn" data-check="2" data-type="unsure">Cannot prove they are off</button>
        <button class="answer-btn" data-check="2" data-type="clear">All three confirmed off</button>
      </div>
      <div class="check-result" id="result-2"></div>
    </div>

    <div class="check-card" id="check-3">
      <div class="check-header">
        <div><div class="check-number">Check 03</div><div class="check-title">Ownership Test</div></div>
        <div class="check-status" id="status-3"></div>
      </div>
      <div class="check-body">Pick your most critical production asset. Ask the listed owner: <em>Can you approve taking this offline for 10 minutes right now?</em></div>
      <div class="answer-row">
        <button class="answer-btn" data-check="3" data-type="gap">Approval was not immediate</button>
        <button class="answer-btn" data-check="3" data-type="unsure">No clear owner listed</button>
        <button class="answer-btn" data-check="3" data-type="clear">Immediate approval confirmed</button>
      </div>
      <div class="check-result" id="result-3"></div>
    </div>

    <div class="check-card" id="check-4">
      <div class="check-header">
        <div><div class="check-number">Check 04</div><div class="check-title">Test and Dev Cleanup</div></div>
        <div class="check-status" id="status-4"></div>
      </div>
      <div class="check-body">Search for assets labeled test, temp, dev, or sandbox. Filter for publicly facing. Pick one.</div>
      <div class="answer-row">
        <button class="answer-btn" data-check="4" data-type="gap">Found one with no owner or expiry</button>
        <button class="answer-btn" data-check="4" data-type="unsure">Cannot run the search</button>
        <button class="answer-btn" data-check="4" data-type="clear">All have owners and expiry dates</button>
      </div>
      <div class="check-result" id="result-4"></div>
    </div>

    <div class="check-card" id="check-5">
      <div class="check-header">
        <div><div class="check-number">Check 05</div><div class="check-title">Asset Drift</div></div>
        <div class="check-status" id="status-5"></div>
      </div>
      <div class="check-body">Count production assets today. Find the count from 3 months ago. Can you explain every addition and removal?</div>
      <div class="answer-row">
        <button class="answer-btn" data-check="5" data-type="gap">Growth I cannot explain</button>
        <button class="answer-btn" data-check="5" data-type="unsure">No historical count exists</button>
        <button class="answer-btn" data-check="5" data-type="clear">Every change is documented</button>
      </div>
      <div class="check-result" id="result-5"></div>
    </div>

    <div id="offer"></div>
    <div class="results-panel" id="resultsPanel">
      <div class="results-title" id="resultsTitle"></div>
      <div class="results-score" id="resultsScore"></div>
      <div class="results-summary" id="resultsSummary"></div>

      <div class="offer-divider">
        <div class="offer-label">Get Address The Mess</div>
        <div class="offer-grid">

          <div class="offer-card contribute">
            <div class="offer-card-label">Contribute</div>
            <div class="offer-card-title">Get it free. Share what you find.</div>
            <div class="offer-card-desc">Run the process, share your findings. No cost.</div>
            <form
              name="atm-contribute"
              method="POST"
              data-netlify="true"
              netlify-honeypot="bot-field"
              id="contributeForm"
              class="contribute-form"
            >
              <input type="hidden" name="form-name" value="atm-contribute" />
              <input type="hidden" name="gap-summary" id="hiddenSummary" />
              <p style="display:none"><input name="bot-field" /></p>
              <input type="text" name="name" placeholder="First name" class="contribute-input" autocomplete="given-name" required />
              <input type="email" name="email" placeholder="Work email" class="contribute-input" required autocomplete="email" />
              <button type="submit" class="contribute-submit">Get free access</button>
            </form>
            <div class="contribute-confirm" id="contributeConfirm" style="display:none;">
              <div class="contribute-confirm-title">You are in.</div>
              <div class="contribute-confirm-body">
                <a href="/Address The Mess-6.pdf" class="download-link" download>
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M7 2v7M4 6l3 3 3-3M2 11h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  Download Address The Mess
                </a>
                <a href="/feedback" class="survey-link">Share your findings once you have run it</a>
              </div>
            </div>
          </div>

          <div class="offer-card buy">
            <div class="offer-card-label">Buy outright</div>
            <div class="offer-card-title">Run it privately. No feedback required.</div>
            <div class="offer-card-desc">Purchase Address The Mess and run it on your own timeline. Authority mapping worksheet, zombie asset checklist, and ROI calculator included.</div>
            <a href="https://2279442040293.gumroad.com/l/sjmcby" class="btn-buy" target="_blank" rel="noopener noreferrer">Get Address The Mess — $47</a>
            <div class="offer-note">One-time purchase. Yours to keep and reuse across systems.</div>
          </div>

        </div>
      </div>
    </div>
  </section>

  <div class="section-divider" id="free-resources"></div>

  <section class="resources-section">
    <div class="section-label">Free resources</div>
    <p class="resources-intro">Run these privately before involving anyone else. Each one surfaces a specific category of gap.</p>
    <a href="/ATM2.pdf" class="resource-card">
      <div class="resource-card-info">
        <div class="resource-card-title">Authority Checks</div>
        <div class="resource-card-meta">Five checks that reveal whether you have authority or just access. 10 min.</div>
      </div>
      <span class="resource-badge">Free · PDF</span>
    </a>
    <a href="/AssetHunt Walkthrough.pdf" class="resource-card">
      <div class="resource-card-info">
        <div class="resource-card-title">AssetHunt Walkthrough</div>
        <div class="resource-card-meta">A 30-minute physical inventory pass. Walk your space, log what you find, flag anything you cannot safely turn off.</div>
      </div>
      <span class="resource-badge">Free · PDF</span>
    </a>
    <a href="/Week One Security Assessment.pdf" class="resource-card">
      <div class="resource-card-info">
        <div class="resource-card-title">Week One Triage Walkthrough</div>
        <div class="resource-card-meta">Fictional FinTech scenario for GRC walkthroughs. Exposure, access gaps, unclear ownership, vendor risk. 45-60 min.</div>
      </div>
      <span class="resource-badge">Free · PDF</span>
    </a>
  </section>

  <footer>
    <div>
      <div class="footer-id">Djerhy Jn Baptiste · CISSP</div>
      <div class="footer-copy">© 2026 djerhy.tech</div>
    </div>
    <div class="footer-links">
      <a href="https://www.linkedin.com/in/djerhyjnbaptiste" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a href="https://x.com/JBDjerhy" target="_blank" rel="noopener noreferrer">X</a>
      <a href="https://www.credly.com/users/djerhy-jn-baptiste" target="_blank" rel="noopener noreferrer">Credly</a>
    </div>
  </footer>
</div>

<script is:inline>
  (function () {
    var answers = {};

    var checkLabels = {
      1: 'Departed Access',
      2: 'Retired Systems',
      3: 'Ownership Test',
      4: 'Test and Dev Cleanup',
      5: 'Asset Drift'
    };

    var resultMessages = {
      gap: 'Process failure. This is a real gap.',
      unsure: 'Visibility failure. You cannot confirm the state.',
      clear: 'Clear. No gap found.'
    };

    function handleAnswer(btn) {
      var checkNum = btn.getAttribute('data-check');
      var type = btn.getAttribute('data-type');
      var card = document.getElementById('check-' + checkNum);

      card.querySelectorAll('.answer-btn').forEach(function (b) {
        b.classList.remove('selected-clear', 'selected-gap', 'selected-unsure');
      });
      btn.classList.add('selected-' + type);

      var status = document.getElementById('status-' + checkNum);
      status.innerHTML = '<svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 6l3 3 5-5" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>';
      status.classList.add('done');
      card.classList.add('answered');

      var resultEl = document.getElementById('result-' + checkNum);
      resultEl.textContent = resultMessages[type];
      resultEl.className = 'check-result show ' + type;

      answers[checkNum] = type;

      if (Object.keys(answers).length === 5) {
        showResults();
      }
    }

    function buildSummaryString(counts) {
      var parts = [];
      if (counts.gap > 0) parts.push(counts.gap + ' process failure' + (counts.gap > 1 ? 's' : ''));
      if (counts.unsure > 0) parts.push(counts.unsure + ' visibility failure' + (counts.unsure > 1 ? 's' : ''));
      if (counts.clear > 0) parts.push(counts.clear + ' clear');
      var details = [];
      for (var i = 1; i <= 5; i++) {
        details.push(checkLabels[i] + ': ' + answers[i]);
      }
      return parts.join(', ') + ' | ' + details.join(' / ');
    }

    function showResults() {
      var counts = { gap: 0, unsure: 0, clear: 0 };
      Object.values(answers).forEach(function (a) { counts[a]++; });
      var totalGaps = counts.gap + counts.unsure;

      var score = document.getElementById('resultsScore');
      score.innerHTML = '';
      if (counts.gap > 0) score.innerHTML += '<span class="score-pill gap">' + counts.gap + ' process failure' + (counts.gap > 1 ? 's' : '') + '</span>';
      if (counts.unsure > 0) score.innerHTML += '<span class="score-pill unsure">' + counts.unsure + ' visibility failure' + (counts.unsure > 1 ? 's' : '') + '</span>';
      if (counts.clear > 0) score.innerHTML += '<span class="score-pill clear">' + counts.clear + ' clear</span>';

      var title = document.getElementById('resultsTitle');
      var summary = document.getElementById('resultsSummary');

      if (totalGaps === 0) {
        title.textContent = 'Strong baseline.';
        summary.textContent = 'You answered all five clearly. That is not common. Running Address The Mess on your highest-risk system will formalize what you already know into something you can hand to leadership or present to an auditor.';
      } else if (totalGaps <= 2) {
        title.textContent = 'You have ' + totalGaps + ' gap' + (totalGaps > 1 ? 's' : '') + ' worth addressing.';
        summary.textContent = 'These are solvable. Address The Mess walks you through mapping one system completely so you can produce a defensible plan before the next audit or incident forces your hand.';
      } else {
        title.textContent = 'You have ' + totalGaps + ' gaps you could not answer.';
        summary.textContent = 'This is exactly the environment Address The Mess was built for. Start with one system. Map the dependencies. Produce a plan that makes the next change safe.';
      }

      var hidden = document.getElementById('hiddenSummary');
      if (hidden) hidden.value = buildSummaryString(counts);

      var panel = document.getElementById('resultsPanel');
      panel.classList.add('show');
      setTimeout(function () {
        panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }, 100);
    }

    function init() {
      document.querySelectorAll('.answer-btn').forEach(function (btn) {
        btn.addEventListener('click', function () { handleAnswer(btn); });
      });

      var form = document.getElementById('contributeForm');
      if (form) {
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          var data = new FormData(form);
          fetch('/', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams(data).toString()
          }).then(function () {
            form.style.display = 'none';
            document.getElementById('contributeConfirm').style.display = 'block';
          }).catch(function () {
            form.style.display = 'none';
            document.getElementById('contributeConfirm').style.display = 'block';
          });
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }

    // Show offer panel directly if linked to via #offer
    if (window.location.hash === '#offer') {
      var panel = document.getElementById('resultsPanel');
      if (panel) {
        panel.classList.add('show');
        setTimeout(function () {
          document.getElementById('offer').scrollIntoView({ behavior: 'smooth' });
        }, 100);
      }
    }
  })();
</script>

</body>
</html>