<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Field Notes | djerhy.tech</title>
  <meta name="description" content="Practitioner observations on asset management, infrastructure, and operational clarity.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Fraunces:ital,wght@0,700;0,900;1,700&display=swap" rel="stylesheet">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">

  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    :root {
      --bg: #0D1117;
      --bg2: #111820;
      --text: #e6edf3;
      --muted: #b1bac4;
      --muted2: #7d8896;
      --border: rgba(230,237,243,0.10);
      --border2: rgba(230,237,243,0.06);
      --panel: rgba(230,237,243,0.03);
      --panel2: rgba(230,237,243,0.055);
      --blue: #2F81F7;
      --blue-hover: #1E6AD8;
      --blue-dim: rgba(47,129,247,0.10);
      --blue-border: rgba(47,129,247,0.25);
      --accent: #7fb0ff;
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }

    .container {
      max-width: 740px;
      margin: 0 auto;
      padding: 0 24px;
    }

    /* NAV */
    nav {
      padding: 22px 0;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .logo {
      font-family: 'DM Sans', sans-serif;
      font-size: 15px;
      font-weight: 600;
      color: var(--text);
      text-decoration: none;
      letter-spacing: 0.2px;
    }

    .nav-links {
      display: flex;
      gap: 28px;
    }

    .nav-links a {
      font-size: 14px;
      color: var(--muted);
      text-decoration: none;
      transition: color 0.15s;
    }

    .nav-links a:hover { color: var(--text); }
    .nav-links a.active { color: var(--text); }

    /* PAGE HEADER */
    .page-header {
      padding: 64px 0 48px;
      border-bottom: 1px solid var(--border);
    }

    .page-eyebrow {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--blue);
      margin-bottom: 14px;
    }

    .page-header h1 {
      font-family: 'Fraunces', serif;
      font-size: clamp(32px, 5vw, 46px);
      font-weight: 900;
      line-height: 1.08;
      letter-spacing: -0.02em;
      margin-bottom: 14px;
    }

    .page-intro {
      font-size: 16px;
      line-height: 1.7;
      color: var(--muted);
      max-width: 560px;
    }

    /* NOTES LIST */
    .notes-list {
      padding: 56px 0;
    }

    /* INDIVIDUAL NOTE */
    .note {
      margin-bottom: 64px;
      padding-bottom: 64px;
      border-bottom: 1px solid var(--border2);
    }

    .note:last-child {
      border-bottom: none;
    }

    .note-meta {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 18px;
    }

    .note-number {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--muted2);
    }

    .note-tag {
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted2);
      background: var(--panel2);
      border: 1px solid var(--border2);
      padding: 3px 10px;
      border-radius: 999px;
    }

    .note h2 {
      font-family: 'Fraunces', serif;
      font-size: clamp(22px, 3.5vw, 30px);
      font-weight: 700;
      line-height: 1.15;
      letter-spacing: -0.015em;
      margin-bottom: 20px;
      color: var(--text);
    }

    .note-body {
      font-size: 15px;
      line-height: 1.85;
      color: var(--muted);
    }

    .note-body p + p {
      margin-top: 16px;
    }

    .note-body strong {
      color: var(--text);
      font-weight: 600;
    }

    .note-body em {
      font-style: italic;
      color: var(--accent);
    }

    /* Pull quote */
    .pull-quote {
      margin: 28px 0;
      padding: 20px 24px;
      border-left: 2px solid var(--blue);
      background: var(--panel);
      border-radius: 0 10px 10px 0;
      font-size: 16px;
      line-height: 1.7;
      color: var(--text);
      font-style: italic;
    }

    /* Numbered list inside note */
    .note-list {
      margin: 20px 0;
      display: grid;
      gap: 16px;
    }

    .note-list-item {
      display: grid;
      grid-template-columns: 28px 1fr;
      gap: 12px;
      align-items: start;
    }

    .note-list-num {
      font-size: 12px;
      font-weight: 700;
      color: var(--blue);
      margin-top: 3px;
      font-family: 'Fraunces', serif;
    }

    .note-list-content {
      font-size: 15px;
      line-height: 1.75;
      color: var(--muted);
    }

    .note-list-content strong {
      display: block;
      color: var(--text);
      font-weight: 600;
      margin-bottom: 4px;
    }

    /* Bullet list */
    .note-bullets {
      margin: 16px 0 16px 0;
      display: grid;
      gap: 8px;
    }

    .note-bullet {
      display: flex;
      gap: 12px;
      align-items: flex-start;
      font-size: 14px;
      color: var(--muted);
      line-height: 1.65;
    }

    .bullet-dot {
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: var(--blue);
      margin-top: 9px;
      flex-shrink: 0;
      opacity: 0.6;
    }

    /* Closing line */
    .note-closer {
      margin-top: 24px;
      padding: 18px 20px;
      background: var(--blue-dim);
      border: 1px solid var(--blue-border);
      border-radius: 10px;
      font-size: 15px;
      line-height: 1.65;
      color: var(--text);
    }

    /* SPRINT NUDGE */
    .sprint-nudge {
      margin: 56px 0;
      padding: 28px 32px;
      background: var(--blue-dim);
      border: 1px solid var(--blue-border);
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      flex-wrap: wrap;
    }

    .sprint-nudge-copy {
      font-size: 15px;
      line-height: 1.6;
      color: var(--text);
      max-width: 420px;
    }

    .sprint-nudge-copy p {
      color: var(--muted);
      font-size: 13px;
      margin-top: 4px;
    }

    .btn-sprint {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: var(--blue);
      color: #fff;
      padding: 14px 22px;
      border-radius: 10px;
      text-decoration: none;
      font-weight: 600;
      font-size: 14px;
      white-space: nowrap;
      transition: background 0.15s, transform 0.08s;
      border: 1px solid rgba(255,255,255,0.08);
      flex-shrink: 0;
    }

    .btn-sprint:hover { background: var(--blue-hover); }
    .btn-sprint:active { transform: translateY(1px); }

    /* FOOTER */
    footer {
      border-top: 1px solid var(--border);
      padding: 36px 0 40px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 16px;
    }

    .footer-id {
      font-size: 13px;
      color: var(--muted);
      font-weight: 500;
    }

    .footer-links {
      display: flex;
      gap: 20px;
    }

    .footer-links a {
      font-size: 13px;
      color: var(--muted2);
      text-decoration: none;
      transition: color 0.15s;
    }

    .footer-links a:hover { color: var(--text); }

    .footer-copy {
      width: 100%;
      font-size: 12px;
      color: var(--muted2);
      margin-top: 4px;
    }

    /* FADE IN */
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(12px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .note {
      animation: fadeUp 0.4s ease both;
    }

    .note:nth-child(1) { animation-delay: 0.05s; }
    .note:nth-child(2) { animation-delay: 0.15s; }
    .note:nth-child(3) { animation-delay: 0.25s; }

    @media (max-width: 600px) {
      .page-header { padding: 48px 0 36px; }
      .sprint-nudge { flex-direction: column; align-items: flex-start; }
      footer { flex-direction: column; align-items: flex-start; }
    }
  </style>
</head>
