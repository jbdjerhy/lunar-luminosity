---
const title = "Share Your Findings | djerhy.tech";
const description = "Share what you found when you ran Address The Mess. Five minutes. Helps build the field report.";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="robots" content="noindex" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Fraunces:ital,wght@0,700;0,900;1,700&display=swap" rel="stylesheet">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --bg: #0D1117;
      --bg2: #111820;
      --text: #e6edf3;
      --muted: #b1bac4;
      --muted2: #7d8896;
      --border: rgba(230,237,243,0.10);
      --border2: rgba(230,237,243,0.06);
      --panel: rgba(230,237,243,0.03);
      --panel2: rgba(230,237,243,0.055);
      --blue: #2F81F7;
      --blue-hover: #1E6AD8;
      --blue-dim: rgba(47,129,247,0.10);
      --blue-border: rgba(47,129,247,0.25);
      --accent: #7fb0ff;
      --green-dim: rgba(34,197,94,0.10);
      --green-border: rgba(34,197,94,0.25);
      --green: #22c55e;
    }
    html { scroll-behavior: smooth; }
    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }
    .container { max-width: 740px; margin: 0 auto; padding: 0 24px; }

    nav {
      padding: 22px 0;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .logo { font-size: 15px; font-weight: 600; color: var(--text); text-decoration: none; letter-spacing: 0.2px; }
    .nav-links { display: flex; gap: 28px; }
    .nav-links a { font-size: 14px; color: var(--muted); text-decoration: none; transition: color 0.15s; }
    .nav-links a:hover { color: var(--text); }

    .page-header { padding: 64px 0 48px; }
    .page-eyebrow { font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--blue); margin-bottom: 14px; }
    .page-header h1 {
      font-family: 'Fraunces', serif;
      font-size: clamp(22px, 3vw, 30px);
      font-weight: 700;
      line-height: 1.2;
      letter-spacing: -0.01em;
      margin-bottom: 14px;
      color: var(--muted);
    }
    .page-intro { font-size: 15px; line-height: 1.7; color: var(--muted2); max-width: 560px; }

    /* Form */
    .survey-section { padding-bottom: 80px; }
    .survey-card {
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 32px;
    }

    .field-group { margin-bottom: 24px; }
    .field-label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      color: var(--text);
      margin-bottom: 6px;
    }
    .field-hint {
      font-size: 12px;
      color: var(--muted2);
      margin-bottom: 10px;
      line-height: 1.5;
    }

    .field-input, .field-textarea, .field-select {
      width: 100%;
      padding: 10px 14px;
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 8px;
      color: var(--text);
      font-family: inherit;
      font-size: 14px;
      outline: none;
      transition: border-color 0.15s;
    }
    .field-input::placeholder,
    .field-textarea::placeholder { color: var(--muted2); }
    .field-input:focus,
    .field-textarea:focus,
    .field-select:focus { border-color: rgba(47,129,247,0.5); }

    .field-textarea { resize: vertical; min-height: 100px; line-height: 1.6; }

    .field-select { cursor: pointer; appearance: none; background-image: url("data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1l5 5 5-5' stroke='%237d8896' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E"); background-repeat: no-repeat; background-position: right 14px center; padding-right: 36px; }
    .field-select option { background: var(--bg2); color: var(--text); }

    .radio-group { display: flex; flex-direction: column; gap: 8px; }
    .radio-label {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 14px;
      color: var(--muted);
      cursor: pointer;
      padding: 10px 14px;
      border-radius: 8px;
      border: 1px solid var(--border);
      background: var(--panel);
      transition: border-color 0.15s, background 0.15s;
    }
    .radio-label:hover { background: var(--panel2); border-color: rgba(230,237,243,0.15); color: var(--text); }
    .radio-label input[type="radio"] { accent-color: var(--blue); width: 15px; height: 15px; flex-shrink: 0; }

    .form-divider { height: 1px; background: var(--border); margin: 28px 0; }

    .submit-btn {
      width: 100%;
      padding: 13px;
      background: var(--blue);
      color: #fff;
      border: none;
      border-radius: 9px;
      font-family: inherit;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.15s;
    }
    .submit-btn:hover { background: var(--blue-hover); }

    .submit-note {
      font-size: 12px;
      color: var(--muted2);
      text-align: center;
      margin-top: 12px;
      line-height: 1.5;
    }

    /* Confirmation */
    .confirm-panel {
      display: none;
      background: var(--green-dim);
      border: 1px solid var(--green-border);
      border-radius: 14px;
      padding: 32px;
      text-align: center;
    }
    .confirm-panel.show { display: block; }
    .confirm-title {
      font-family: 'Fraunces', serif;
      font-size: 22px;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 12px;
    }
    .confirm-body {
      font-size: 15px;
      color: var(--muted);
      line-height: 1.7;
      max-width: 440px;
      margin: 0 auto;
    }

    footer {
      border-top: 1px solid var(--border); padding: 36px 0 40px;
      display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;
    }
    .footer-id { font-size: 13px; color: var(--muted); font-weight: 500; }
    .footer-links { display: flex; gap: 20px; }
    .footer-links a { font-size: 13px; color: var(--muted2); text-decoration: none; transition: color 0.15s; }
    .footer-links a:hover { color: var(--text); }
    .footer-copy { width: 100%; font-size: 12px; color: var(--muted2); margin-top: 4px; }

    @media (max-width: 600px) {
      .page-header { padding: 48px 0 36px; }
      .survey-card { padding: 22px 20px; }
      footer { flex-direction: column; align-items: flex-start; }
    }
  </style>
</head>
<body>

<div class="container">
  <nav>
    <a href="/" class="logo">djerhy.tech</a>
    <div class="nav-links">
      <a href="/start-here">Start Here</a>
      <a href="/field-notes">Field Notes</a>
    </div>
  </nav>
</div>

<div class="container">
  <header class="page-header">
    <div class="page-eyebrow">Field Report</div>
    <h1>Share what you found.</h1>
    <p class="page-intro">
      Five minutes. Your findings help build a field report on how real environments perform against the Address The Mess framework. Everything is anonymized unless you choose otherwise.
    </p>
  </header>

  <section class="survey-section">

    <div class="survey-card" id="surveyCard">
      <form
        name="atm-feedback"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        id="feedbackForm"
      >
        <input type="hidden" name="form-name" value="atm-feedback" />
        <p style="display:none"><input name="bot-field" /></p>

        <div class="field-group">
          <label class="field-label" for="org-type">What type of environment did you run it in?</label>
          <select name="org-type" id="org-type" class="field-select" required>
            <option value="" disabled selected>Select one</option>
            <option value="smb">Small business (under 100 people)</option>
            <option value="midmarket">Mid-market (100 to 1000 people)</option>
            <option value="enterprise">Enterprise (1000 plus people)</option>
            <option value="government">Government or public sector</option>
            <option value="nonprofit">Nonprofit</option>
            <option value="other">Other</option>
          </select>
        </div>

        <div class="form-divider"></div>

        <div class="field-group">
          <label class="field-label" for="what-found">What did you find?</label>
          <div class="field-hint">Describe what surfaced when you ran the process. Specific is better than general. Names and systems will be anonymized.</div>
          <textarea name="what-found" id="what-found" class="field-textarea" placeholder="We discovered two service accounts nobody owned. The listed owner for our ERP had left six months prior..." required></textarea>
        </div>

        <div class="form-divider"></div>

        <div class="field-group">
          <label class="field-label" for="what-happened">What happened next?</label>
          <div class="field-hint">Did you act on it? Did you surface it to leadership? Did anything change?</div>
          <textarea name="what-happened" id="what-happened" class="field-textarea" placeholder="We escalated to the CISO. Three accounts were deprovisioned within a week..."></textarea>
        </div>

        <div class="form-divider"></div>

        <div class="field-group">
          <label class="field-label">Can your findings be referenced?</label>
          <div class="field-hint">Used only in aggregate reports or case studies, never tied to your name or organization without permission.</div>
          <div class="radio-group">
            <label class="radio-label">
              <input type="radio" name="attribution" value="yes" required />
              Yes, you can reference my findings with my name
            </label>
            <label class="radio-label">
              <input type="radio" name="attribution" value="anonymous" />
              Yes, but anonymously only
            </label>
            <label class="radio-label">
              <input type="radio" name="attribution" value="no" />
              No, keep this private
            </label>
          </div>
        </div>

        <div class="form-divider"></div>

        <div class="field-group" style="margin-bottom: 0;">
          <label class="field-label" for="email">Your email</label>
          <div class="field-hint">So I can follow up if your findings would be useful to discuss further. Optional.</div>
          <input type="email" name="email" id="email" class="field-input" placeholder="you@company.com" autocomplete="email" />
        </div>

        <div class="form-divider"></div>

        <button type="submit" class="submit-btn">Submit findings</button>
        <p class="submit-note">No marketing. No list. Just one person reading your results.</p>

      </form>
    </div>

    <div class="confirm-panel" id="confirmPanel">
      <div class="confirm-title">Thank you.</div>
      <div class="confirm-body">Your findings have been received. I read every submission personally and will follow up if your situation warrants a conversation.</div>
    </div>

  </section>

  <footer>
    <div>
      <div class="footer-id">Djerhy Jn Baptiste · CISSP</div>
      <div class="footer-copy">© 2026 djerhy.tech</div>
    </div>
    <div class="footer-links">
      <a href="https://www.linkedin.com/in/djerhyjnbaptiste" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a href="https://x.com/JBDjerhy" target="_blank" rel="noopener noreferrer">X</a>
      <a href="https://www.credly.com/users/djerhy-jn-baptiste" target="_blank" rel="noopener noreferrer">Credly</a>
    </div>
  </footer>
</div>

<script is:inline>
  (function () {
    var form = document.getElementById('feedbackForm');
    var card = document.getElementById('surveyCard');
    var confirm = document.getElementById('confirmPanel');

    if (form) {
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var data = new FormData(form);
        fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(data).toString()
        }).then(function () {
          card.style.display = 'none';
          confirm.classList.add('show');
          confirm.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }).catch(function () {
          card.style.display = 'none';
          confirm.classList.add('show');
        });
      });
    }
  })();
</script>

</body>
</html>