---
const title = "Field Notes | djerhy.tech";
const description = "Operational checks for messy environments. Run these before you change anything.";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>

  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">

  <link rel="icon" type="image/svg+xml" href="/favicon.svg">

  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    :root {
      --bg: #0D1117;
      --text: #e6edf3;
      --muted: #b1bac4;
      --muted2: #9aa4af;
      --border: rgba(230, 237, 243, 0.12);
      --border2: rgba(230, 237, 243, 0.10);
      --panel: rgba(230, 237, 243, 0.035);
      --panelHover: rgba(230, 237, 243, 0.055);
      --primary: #2F81F7;
      --primaryHover: #1E6AD8;
      --accentPanel: rgba(47, 129, 247, 0.08);
      --accentBorder: rgba(47, 129, 247, 0.28);
      --accentPanelHover: rgba(47, 129, 247, 0.11);
      --accentBorderHover: rgba(47, 129, 247, 0.40);
      --accentText: #7fb0ff;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
    }

    .container {
      max-width: 720px;
      margin: 0 auto;
      padding: 40px 20px;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    header {
      margin-bottom: 56px;
      padding-bottom: 20px;
      border-bottom: 1px solid var(--border);
    }

    .logo {
      font-size: 15px;
      font-weight: 650;
      color: var(--text);
      text-decoration: none;
      letter-spacing: 0.3px;
    }

    nav {
      display: flex;
      gap: 24px;
      margin-top: 16px;
      flex-wrap: wrap;
    }

    nav a {
      font-size: 14px;
      color: var(--muted);
      text-decoration: none;
      transition: color 0.2s;
    }

    nav a:hover { color: var(--text); }

    main { flex: 1; }

    h1 {
      font-size: clamp(32px, 5vw, 46px);
      line-height: 1.1;
      font-weight: 750;
      letter-spacing: -0.02em;
      margin-bottom: 14px;
    }

    .intro {
      font-size: 16px;
      line-height: 1.7;
      color: var(--muted);
      margin-bottom: 14px;
      max-width: 640px;
    }

    .subnote {
      font-size: 14px;
      line-height: 1.7;
      color: var(--muted2);
      margin-bottom: 28px;
      max-width: 640px;
    }

    .section-label {
      font-size: 12px;
      font-weight: 800;
      color: var(--muted2);
      text-transform: uppercase;
      letter-spacing: 1px;
      margin: 40px 0 14px 0;
    }

    .resource-card {
      display: block;
      background: var(--panel);
      border: 1px solid var(--border2);
      border-radius: 12px;
      padding: 20px;
      margin-bottom: 12px;
      text-decoration: none;
      transition: border-color 0.2s, background 0.2s, transform 0.2s;
    }

    .resource-card:hover {
      background: var(--panelHover);
      border-color: rgba(230, 237, 243, 0.18);
      transform: translateY(-1px);
    }

    .resource-card-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 14px;
      margin-bottom: 8px;
    }

    .resource-title {
      font-size: 16px;
      font-weight: 750;
      color: var(--text);
      line-height: 1.35;
    }

    .resource-badge {
      font-size: 11px;
      font-weight: 850;
      color: var(--muted);
      background: rgba(230, 237, 243, 0.06);
      border: 1px solid rgba(230, 237, 243, 0.12);
      padding: 4px 10px;
      border-radius: 999px;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      white-space: nowrap;
      flex-shrink: 0;
    }

    .resource-badge.free {
      background: rgba(47, 129, 247, 0.16);
      border-color: rgba(47, 129, 247, 0.30);
      color: var(--accentText);
    }

    .resource-desc {
      font-size: 14px;
      line-height: 1.6;
      color: var(--muted);
      max-width: 640px;
    }

    .resource-meta {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-top: 10px;
    }

    .meta-pill {
      font-size: 12px;
      color: var(--muted2);
      background: rgba(230, 237, 243, 0.04);
      border: 1px solid rgba(230, 237, 243, 0.10);
      padding: 6px 10px;
      border-radius: 999px;
      white-space: nowrap;
    }

    .card-actions {
      margin-top: 14px;
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }

    .btn {
      display: inline-block;
      padding: 10px 14px;
      border-radius: 10px;
      text-decoration: none;
      font-weight: 800;
      font-size: 13px;
      letter-spacing: 0.2px;
      user-select: none;
    }

    .btn-primary {
      background: var(--primary);
      color: #fff;
      border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .btn-primary:hover { background: var(--primaryHover); }

    .btn-secondary {
      background: rgba(230, 237, 243, 0.03);
      color: var(--text);
      border: 1px solid rgba(230, 237, 243, 0.10);
    }

    .btn-secondary:hover {
      background: rgba(230, 237, 243, 0.05);
      border-color: rgba(230, 237, 243, 0.18);
    }

    .featured-card {
      background: var(--accentPanel);
      border: 1px solid var(--accentBorder);
    }

    .featured-card:hover {
      background: var(--accentPanelHover);
      border-color: var(--accentBorderHover);
    }

    .helper-box {
      margin-top: 18px;
      background: rgba(230, 237, 243, 0.03);
      border: 1px solid rgba(230, 237, 243, 0.10);
      border-radius: 12px;
      padding: 18px 18px;
      color: var(--muted);
      font-size: 14px;
      line-height: 1.65;
      max-width: 640px;
    }

    .helper-box strong { color: var(--text); }

    .contact {
      margin-top: 52px;
      padding-top: 36px;
      border-top: 1px solid var(--border);
      text-align: center;
      font-size: 14px;
      color: var(--muted);
    }

    .contact a { color: var(--primary); text-decoration: none; }
    .contact a:hover { text-decoration: underline; }

    footer {
      padding-top: 36px;
      border-top: 1px solid var(--border);
      font-size: 13px;
      color: var(--muted2);
      margin-top: 56px;
    }

    .footer-identity { margin-bottom: 12px; color: var(--muted); }
    .footer-links {
      display: flex;
      gap: 16px;
      flex-wrap: wrap;
      margin-bottom: 16px;
    }

    footer a { color: var(--muted); text-decoration: none; }
    footer a:hover { color: var(--text); }

    @media (max-width: 640px) {
      .container { padding: 32px 16px; }
      h1 { font-size: 28px; }
      .resource-card-header { flex-direction: column; gap: 10px; }
    }
  </style>
</head>

<body>
  <div class="container">
    <header>
      <a href="/" class="logo">djerhy.tech</a>
      <nav>
        <a href="/start-here">Start Here</a>
        <a href="/resources">Field Notes</a>
      </nav>
    </header>

    <main>
      <h1>Run These Before You Change Anything</h1>

      <p class="intro">
        Start with a quick internal check to surface ownership and dependency risk.
        If the answers aren't immediate, run the one-system sprint and turn uncertainty into a defensible plan.
      </p>

      <p class="subnote">
        No email &bull; run it privately &bull; built for messy environments.
      </p>

      <!-- FREE FIRST -->
      <div class="section-label">Run First (Free)</div>

      <a href="/ATM2.pdf" class="resource-card">
        <div class="resource-card-header">
          <div class="resource-title">Authority Checks</div>
          <div class="resource-badge free">FREE</div>
        </div>
        <div class="resource-desc">
          Five immediate checks that reveal whether you have authority or just access. Each one takes under 10 minutes and produces a clear answer.
        </div>
        <div class="resource-meta">
          <span class="meta-pill">10 min</span>
          <span class="meta-pill">Anyone running discovery</span>
        </div>
        <div class="card-actions">
          <span class="btn btn-primary">Run the checks</span>
        </div>
      </a>

      <a href="/AssetHunt Walkthrough.pdf" class="resource-card">
        <div class="resource-card-header">
          <div class="resource-title">AssetHunt Walkthrough</div>
          <div class="resource-badge free">FREE</div>
        </div>
        <div class="resource-desc">
          A 30-minute physical inventory pass. Walk your space, log what you find, ask who owns it, and flag anything you cannot safely turn off.
        </div>
        <div class="resource-meta">
          <span class="meta-pill">30 min</span>
          <span class="meta-pill">Operators / IT managers</span>
        </div>
        <div class="card-actions">
          <span class="btn btn-primary">Open walkthrough</span>
        </div>
      </a>

      <a href="/Week One Security Assessment.pdf" class="resource-card">
        <div class="resource-card-header">
          <div class="resource-title">Week One Triage Walkthrough</div>
          <div class="resource-badge free">FREE</div>
        </div>
        <div class="resource-desc">
          A fictional FinTech scenario built for practical GRC walkthroughs. Use it to work through week-one triage: exposure, access gaps, unclear ownership, and vendor risk.
        </div>
        <div class="resource-meta">
          <span class="meta-pill">45-60 min</span>
          <span class="meta-pill">Security / IT leadership</span>
        </div>
        <div class="card-actions">
          <span class="btn btn-primary">Open walkthrough</span>
        </div>
      </a>

      <div class="helper-box">
        <strong>What the free checks give you:</strong> a clear list of what you know vs what you are guessing about.<br>
        <strong>What they don't give you:</strong> a structured way to turn those findings into safe change without losing weeks to meetings and backtracking.
      </div>

      <!-- PAID SECOND -->
      <div class="section-label">Run Next (Paid)</div>

      <p style="font-size: 14px; color: var(--muted2); margin-bottom: 14px;">
        If you ran a check and found gaps you could not answer, this is the next step.
      </p>

      <a href="https://2279442040293.gumroad.com/l/sjmcby" class="resource-card featured-card" target="_blank" rel="noopener noreferrer">
        <div class="resource-card-header">
          <div class="resource-title">Run the One-System Authority Sprint</div>
          <div class="resource-badge">PAID &bull; ONE SYSTEM</div>
        </div>
        <div class="resource-desc">
          A 30-day process to identify ownership and safely change one real system. Includes the authority mapping worksheet, zombie asset checklist, MVE enrichment schema, and decommissioning ROI calculator.
        </div>
        <div class="resource-meta">
          <span class="meta-pill">30 days</span>
          <span class="meta-pill">One system</span>
          <span class="meta-pill">$9.99</span>
        </div>
        <div class="card-actions">
          <span class="btn btn-secondary">Run the Sprint</span>
        </div>
      </a>

      <div class="helper-box">
        <strong>What you produce:</strong> an internal summary you can hand to your manager that answers four questions about a real system: who is accountable, who has access, what depends on it, and what change would be risky.
      </div>

      <div class="contact">
        Questions? <a href="mailto:contact@djerhy.tech">contact@djerhy.tech</a>
      </div>
    </main>

    <footer>
      <div class="footer-identity">Djerhy Jn Baptiste &bull; CISSP</div>
      <div class="footer-links">
        <a href="https://www.linkedin.com/in/djerhyjnbaptiste" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href="https://x.com/JBDjerhy" target="_blank" rel="noopener noreferrer">X</a>
        <a href="https://www.credly.com/users/djerhy-jn-baptiste" target="_blank" rel="noopener noreferrer">Credly</a>
      </div>
      <div>&copy; 2026 djerhy.tech</div>
    </footer>
  </div>
</body>
</html>